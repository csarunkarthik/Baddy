# Where to send detected bookings — your deployed Baddy URL (no trailing slash).
BADDY_URL=https://baddy.vercel.app

# Must match INGEST_SECRET in the Baddy project's env.
INGEST_SECRET=

# The WhatsApp group to watch. Run `npm run list-groups` after logging in
# once; it prints every group with its id. Looks like 1234567890-1234567890@g.us
# (or ...@g.us for newer groups).
GROUP_ID=

# Optional: log every message the gate rejects, to tune the filter. Noisy.
DEBUG_ALL_MESSAGES=false

# How many hours of recent messages to read on startup. Lets a restart, or a
# laptop waking from sleep, catch up on bookings posted while it was down —
# safe because the server dedupes by message id. Raise it if your host is
# offline for long stretches; don't set it so high that old sessions get
# re-announced.
LOOKBACK_HOURS=6

# Hard ceiling on posts per day. The bot also spaces sends out and jitters the
# timing; this is the backstop against a bug becoming spam.
MAX_SENDS_PER_DAY=25
